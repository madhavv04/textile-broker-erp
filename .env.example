# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<your-strong-random-secret-key>

# ── DATABASE ───────────────────────────────────────────────────────────────────
# SQLite (dev default):
DATABASE_URL=sqlite:///./textile_broker.db
# PostgreSQL (used by docker-compose.yml's `db` service):
# DATABASE_URL=postgresql://textile:textile@db:5432/textile_broker

# ── APP ────────────────────────────────────────────────────────────────────────
# "dev" returns dev_otp in API response; "prod" hides it and requires SMS provider
ENV=dev

# Token lifetime in minutes (default 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── ADMIN (used by scripts/backfill_owner.py) ──────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production (Railway) — replace with your actual Railway URL:
# CORS_ORIGINS=https://your-app.up.railway.app

# ── GOOGLE OAUTH ───────────────────────────────────────────────────────────────
# Obtain from: https://console.cloud.google.com → APIs & Services → Credentials
# Required APIs: Google People API
# Required Scopes: openid, email, profile, https://www.googleapis.com/auth/contacts.readonly
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# Redirect URI must exactly match what is registered in Google Cloud Console.
# Development:
# GOOGLE_REDIRECT_URI=http://localhost:5173/google-callback
# Production (Railway):
GOOGLE_REDIRECT_URI=https://textile-broker.up.railway.app/google-callback
